#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# Sub-path is rejected at install time; only a domain change is relevant here.
ynh_script_progression "Re-creating the NGINX configuration for the new URL..."

ynh_config_add_nginx

ynh_systemctl --service="$app" --action="restart"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Change of URL completed for $app"
